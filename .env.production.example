# ==============================================================================
# POSEIDON CTI Platform — Production Environment Configuration Template
# Conforming to Prompt 03 DevSecOps & Security Hardening
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Security
# ------------------------------------------------------------------------------
POSEIDON_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-char-hex-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["https://cti.yourdomain.com", "http://localhost:8080"]

# Initial Administrator Credentials (seeded on first startup)
FIRST_ADMIN_EMAIL=admin@poseidon.sec
FIRST_ADMIN_PASSWORD=ChangeMe2026!Immediately

# ------------------------------------------------------------------------------
# 2. Database & Persistence (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=poseidon_admin
POSTGRES_PASSWORD=generate-a-strong-database-password-here
POSTGRES_DB=poseidon
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://poseidon_admin:generate-a-strong-database-password-here@postgres:5432/poseidon

# ------------------------------------------------------------------------------
# 3. Cache & Lock Broker (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=generate-a-strong-redis-password-here
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:generate-a-strong-redis-password-here@redis:6379/0

# ------------------------------------------------------------------------------
# 4. OASIS TAXII 2.1 Server Configuration
# ------------------------------------------------------------------------------
TAXII_SERVER_TITLE=POSEIDON TAXII 2.1 Server
TAXII_SERVER_DESCRIPTION=Enterprise Cyber Threat Intelligence Exchange Node
TAXII_SERVER_CONTACT=soc-cti@poseidon.sec
TAXII_DEFAULT_API_ROOT=root
TAXII_MAX_CONTENT_LENGTH=10485760

# ------------------------------------------------------------------------------
# 5. External CTI & Threat Surface Connectors (Optional / Zero-Cloud Fallback)
# ------------------------------------------------------------------------------
SHODAN_API_KEY=
CENSYS_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
VIRUSTOTAL_API_KEY=

# ------------------------------------------------------------------------------
# 6. Live MISP Instance Synchronization (Optional)
# ------------------------------------------------------------------------------
MISP_DEFAULT_URL=
MISP_DEFAULT_API_KEY=
MISP_VERIFY_SSL=true

# ------------------------------------------------------------------------------
# 7. AI Threat Analyst LLM Provider (Optional / Local Fallback Active by Default)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
